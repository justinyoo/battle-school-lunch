    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://open.neis.go.kr/hub",
      "description": "NEIS Open API"
    }
  ],
  "paths": {
    "/schoolInfo": {
      "get": {
        "operationId": "getSchoolInfo",
