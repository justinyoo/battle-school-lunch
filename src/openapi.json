  "components": {
    "parameters": {
      "Key": {
        "name": "Key",
        "in": "query",
        "required": true,
        "description": "인증키. 기본값은 sample key입니다.",
        "schema": {
          "type": "string",
          "default": "sample key"
        }
      },
      "Type": {
        "name": "Type",
        "in": "query",
        "required": true,
        "description": "호출 문서 형식입니다.",
        "schema": {
          "type": "string",
          "enum": [
            "xml",
            "json"
          ],
          "default": "xml"
        }
      },
      "PIndex": {
        "name": "pIndex",
        "in": "query",
        "required": true,
        "description": "페이지 위치. sample key 사용 시 1로 고정됩니다.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "default": 1,
          "minimum": 1
        }
      },
      "PSize": {
        "name": "pSize",
        "in": "query",
        "required": true,
        "description": "페이지당 요청 숫자. sample key 사용 시 5로 고정됩니다.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "default": 100,
          "minimum": 1,
          "maximum": 1000
        }
      },
      "AtptOfcdcScCode": {
        "name": "ATPT_OFCDC_SC_CODE",
        "in": "query",
        "required": false,
        "description": "시도교육청코드. 학교를 관리하는 시도교육청 기관코드입니다.",
        "schema": {
          "type": "string"
        }
      },
      "AtptOfcdcScCodeRequired": {
        "name": "ATPT_OFCDC_SC_CODE",
        "in": "query",
        "required": true,
        "description": "시도교육청코드. 시도교육청구분코드입니다.",
        "schema": {
          "type": "string"
        }
      },
      "SdSchulCode": {
        "name": "SD_SCHUL_CODE",
        "in": "query",
        "required": false,
        "description": "행정표준코드입니다.",
        "schema": {
          "type": "string"
        }
      },
      "SdSchulCodeRequired": {
        "name": "SD_SCHUL_CODE",
        "in": "query",
