          {
            "$ref": "#/components/parameters/Type"
          },
          {
            "$ref": "#/components/parameters/PIndex"
          },
          {
            "$ref": "#/components/parameters/PSize"
          },
          {
            "$ref": "#/components/parameters/AtptOfcdcScCode"
          },
          {
            "$ref": "#/components/parameters/SdSchulCode"
          },
          {
            "$ref": "#/components/parameters/SchulNm"
          },
          {
            "$ref": "#/components/parameters/SchulKndScNm"
          },
          {
            "$ref": "#/components/parameters/LctnScNm"
          },
          {
            "$ref": "#/components/parameters/FondScNm"
          }
        ],
        "responses": {
          "200": {
            "description": "정상 처리되었습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchoolInfoResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/NeisXmlResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/RequiredValueError"
          },
          "422": {
            "$ref": "#/components/responses/InvalidTypeError"
          },
          "401": {
            "$ref": "#/components/responses/InvalidKeyError"
          },
          "404": {
            "$ref": "#/components/responses/ServiceNotFoundError"
          },
          "413": {
            "$ref": "#/components/responses/RequestLimitError"
          },
          "429": {
            "$ref": "#/components/responses/TrafficLimitError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "503": {
            "$ref": "#/components/responses/DatabaseError"
          }
        }
      }
    },
    "/mealServiceDietInfo": {
      "get": {
        "operationId": "getMealServiceDietInfo",
        "summary": "급식식단정보 조회",
